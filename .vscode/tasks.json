{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "dotnet",
      "task": "restore",
      "problemMatcher": ["$msCompile"],
      "group": "build",
      "label": "dotnet: restore"
    },
    {
      "type": "dotnet",
      "task": "build",
      "problemMatcher": ["$msCompile"],
      "group": "build",
      "label": "dotnet: build"
    },
    {
      "type": "shell",
      "command": "dotnet",
      "args": ["format", "DancingGoat.slnx"],
      "problemMatcher": ["$msCompile"],
      "group": "none",
      "label": "dotnet: format"
    },
    {
      "type": "dotnet",
      "task": "clean",
      "problemMatcher": ["$msCompile"],
      "group": "build",
      "label": "dotnet: clean"
    },

    {
      "label": "dotnet: watch DancingGoat",
      "command": "dotnet",
      "type": "process",
      "args": [
        "watch",
        "run",
        "--project",
        "${workspaceFolder}/src/DancingGoat/DancingGoat.csproj"
      ],
      "options": {
        "env": {
          "DOTNET_WATCH_RESTART_ON_RUDE_EDIT": "true"
        }
      },
      "problemMatcher": "$msCompile"
    },
    {
      "type": "npm",
      "script": "install",
      "path": "tests",
      "group": "build",
      "problemMatcher": [],
      "label": "npm: install - tests",
      "detail": "install dependencies from package"
    },
    {
      "type": "shell",
      "command": "npx",
      "args": ["playwright", "install", "--with-deps"],
      "options": {
        "cwd": "${workspaceFolder}/tests"
      },
      "problemMatcher": [],
      "label": "playwright: install browsers"
    },
    {
      "label": "playwright: setup",
      "dependsOrder": "sequence",
      "dependsOn": ["npm: install - tests", "playwright: install browsers"],
      "problemMatcher": []
    },
    {
      "type": "shell",
      "command": "npx",
      "args": ["playwright", "test"],
      "dependsOrder": "sequence",
      "dependsOn": ["playwright: setup"],
      "options": {
        "cwd": "${workspaceFolder}/tests"
      },
      "problemMatcher": [],
      "label": "playwright: test"
    },
    {
      "type": "shell",
      "command": "npx",
      "args": ["playwright", "show-report"],
      "options": {
        "cwd": "${workspaceFolder}/tests"
      },
      "problemMatcher": [],
      "label": "playwright: show report"
    }
  ]
}
